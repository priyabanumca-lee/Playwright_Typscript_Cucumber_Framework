{
  "dependencies": {
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.10",
    "multiple-cucumber-html-reporter": "^4.6.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "winston": "^3.19.0"
  },
  "scripts": {
    "generate-report": "node --import tsx/esm generate-report.ts",
    "test:with-report": "cucumber-js --import tsx/esm && node --import tsx/esm generate-report.ts",
    "test:failed": "cucumber-js --import tsx/esm @rerun.txt",
    "test:parallel": "cucumber-js --import tsx/esm --parallel",
    "test": "cross-env ENV=test cucumber-js test || true  --import tsx/esm"
  }
}
